\section{Tema 3. Transformación y composición de funciones}

\subsection*{1.- Sea $f(x)=x^2$. Realiza las siguientes transformaciones de la función. Muestra la gráfica resultante.}
\begin{enumerate}[label=\alph*)]
  \item Desplazamiento vertical 2 unidades hacia arriba: $y=x^2+2$.
  \item Desplazamiento vertical 2 unidades hacia abajo: $y=x^2-2$.
  \item Desplazamiento horizontal 2 unidades a la derecha: $y=(x-2)^2$.
  \item Desplazamiento horizontal 2 unidades a la izquierda: $y=(x+2)^2$.
  \item Alargamiento vertical por un factor de 2: $y=2x^2$.
  \item Compresión vertical por un factor de 2: $y=\dfrac12x^2$.
  \item Compresión horizontal por un factor de 2: $y=f(2x)=4x^2$.
  \item Alargamiento horizontal por un factor de 2: $y=f\left(\dfrac{x}{2}\right)=\dfrac{x^2}{4}$.
  \item Reflexión sobre el eje $x$: $y=-x^2$.
  \item Reflexión sobre el eje $y$: $y=f(-x)=(-x)^2=x^2$ (la gráfica no cambia).
\end{enumerate}
\grafica

\subsection*{2.- Sea $f(x)=\sqrt{x}$. Realiza las siguientes transformaciones de la función. Muestra la gráfica resultante.}
\begin{enumerate}[label=\alph*)]
  \item Desplazamiento vertical 2 unidades hacia arriba: $y=\sqrt{x}+2$.
  \item Desplazamiento vertical 2 unidades hacia abajo: $y=\sqrt{x}-2$.
  \item Desplazamiento horizontal 2 unidades a la derecha: $y=\sqrt{x-2}$.
  \item Desplazamiento horizontal 2 unidades a la izquierda: $y=\sqrt{x+2}$.
  \item Alargamiento vertical por un factor de 2: $y=2\sqrt{x}$.
  \item Compresión vertical por un factor de 2: $y=\dfrac12\sqrt{x}$.
  \item Compresión horizontal por un factor de 2: $y=f(2x)=\sqrt{2x}$.
  \item Alargamiento horizontal por un factor de 2: $y=f\left(\dfrac{x}{2}\right)=\sqrt{\dfrac{x}{2}}$.
  \item Reflexión sobre el eje $x$: $y=-\sqrt{x}$.
  \item Reflexión sobre el eje $y$: $y=f(-x)=\sqrt{-x}$.
\end{enumerate}
\grafica

\subsection*{3.- Sean $f(x)=\sqrt{x}$, $g(x)=x-3$, $h(x)=\sin x$. Encuentre:}
\begin{enumerate}[label=\alph*)]
  \item $(f\circ g)(x)=f(g(x))=\sqrt{x-3}$, con $x\geq3$.
  \item $(f\circ h)(x)=f(h(x))=\sqrt{\sin x}$, donde $\sin x\geq0$.
  \item $(g\circ f)(x)=g(f(x))=\sqrt{x}-3$, con $x\geq0$.
  \item $(g\circ h)(x)=g(h(x))=\sin x-3$.
  \item $(h\circ f)(x)=h(f(x))=\sin(\sqrt{x})$, con $x\geq0$.
  \item $(h\circ g)(x)=h(g(x))=\sin(x-3)$.
  \item $(f\circ f)(x)=f(f(x))=\sqrt{\sqrt{x}}=\sqrt[4]{x}$, con $x\geq0$.
  \item $(g\circ g)(x)=g(g(x))=(x-3)-3=x-6$.
  \item $(h\circ h)(x)=h(h(x))=\sin(\sin x)$.
\end{enumerate}

