\section{Tema 11. Técnicas de integración: integración por cambio de variable e integración por partes}

\subsection{1.- Resuelve utilizando el método de integración por cambio de variable:}
\begin{enumerate}[label=\alph*)]
  \item $\displaystyle\int2x\sin(x^2)dx$. $u=x^2$, $du=2x\,dx$: $\boxed{-\cos(x^2)+C}$.
  \item $\displaystyle\int3x^2e^{x^3}dx$. $u=x^3$, $du=3x^2\,dx$: $\boxed{e^{x^3}+C}$.
  \item $\displaystyle\int x^2e^{x^3}dx$. $u=x^3$, $du=3x^2\,dx$: $\boxed{\frac13e^{x^3}+C}$.
  \item $\displaystyle\int x\sin(x^2)dx$. $u=x^2$, $du=2x\,dx$: $\boxed{-\frac12\cos(x^2)+C}$.
  \item $\displaystyle\int e^{-2x}dx=\boxed{-\frac12e^{-2x}+C}$.
  \item $\displaystyle\int\frac1{5-3x}dx$. $u=5-3x$, $du=-3dx$: $\boxed{-\frac13\ln|5-3x|+C}$.
  \item $\displaystyle\int\frac{x^2}{x^3+1}dx$. $u=x^3+1$, $du=3x^2dx$: $\boxed{\frac13\ln|x^3+1|+C}$.
  \item $\displaystyle\int\frac{(\ln x)^2}{x}dx$. $u=\ln x$, $du=dx/x$: $\boxed{\frac{(\ln x)^3}{3}+C}$.
  \item $\displaystyle\int(x+1)\sqrt{2x+x^2}\,dx$. $u=x^2+2x$, $du=2(x+1)dx$: $\boxed{\frac13(2x+x^2)^{3/2}+C}$.
  \item $\displaystyle\int(\cos^4\theta)(\sin\theta)d\theta$. $u=\cos\theta$, $du=-\sin\theta d\theta$: $\boxed{-\frac15\cos^5\theta+C}$.
  \item $\displaystyle\int\frac{e^u}{(1-e^u)^2}du$. $v=1-e^u$, $dv=-e^u du$: $\boxed{\frac1{1-e^u}+C}$.
  \item $\displaystyle\int_0^1\cos\left(\frac{\pi t}{2}\right)dt$
  \[
  =\left[\frac2\pi\sin\left(\frac{\pi t}{2}\right)\right]_0^1
  =\boxed{\frac2\pi}.
  \]
\end{enumerate}

\subsection{2.- Resuelve utilizando el método de integración por partes:}
Se utiliza $\displaystyle\int u\,dv=uv-\int v\,du$.
\begin{enumerate}[label=\alph*)]
  \item $\displaystyle\int x\cos5x\,dx$. Tomamos $u=x$, $dv=\cos5x\,dx$:
  $\boxed{\frac{x\sin5x}{5}+\frac{\cos5x}{25}+C}$.
  \item $\displaystyle\int te^{-3t}dt$. Con $u=t$, $dv=e^{-3t}dt$:
  $\boxed{-\frac{te^{-3t}}3-\frac{e^{-3t}}9+C}$.
  \item $\displaystyle\int(x^2+2x)\cos x\,dx$. Aplicando partes dos veces:
  $\boxed{(x^2+2x-2)\sin x+(2x+2)\cos x+C}$.
  \item $\displaystyle\int x^2\ln x\,dx$. Con $u=\ln x$, $dv=x^2dx$:
  $\boxed{\frac{x^3}{3}\ln x-\frac{x^3}{9}+C}$.
  \item $\displaystyle\int(\ln x)^2dx$. Con $u=(\ln x)^2$, $dv=dx$ y aplicando partes otra vez:
  $\boxed{x(\ln x)^2-2x\ln x+2x+C}$.
  \item $\displaystyle\int\sqrt{x^3}\ln x\,dx=\int x^{3/2}\ln x\,dx$:
  $\boxed{\frac25x^{5/2}\ln x-\frac4{25}x^{5/2}+C}$.
  \item $\displaystyle\int x^3\sin x\,dx$. Aplicando partes repetidamente:
  $\boxed{-x^3\cos x+3x^2\sin x+6x\cos x-6\sin x+C}$.
  \item $\displaystyle\int x^5e^{-x}dx$. Aplicando partes repetidamente:
  $\boxed{-e^{-x}(x^5+5x^4+20x^3+60x^2+120x+120)+C}$.
  \item $\displaystyle\int e^x\cos x\,dx$. Aplicando partes dos veces y despejando la integral original:
  $\boxed{\frac{e^x}{2}(\sin x+\cos x)+C}$.
  \item $\displaystyle\int\sin(\ln x)dx$. Sea $u=\ln x$, entonces $x=e^u$ y $dx=e^u du$:
  $\boxed{\frac{x}{2}\left[\sin(\ln x)-\cos(\ln x)\right]+C}$.
\end{enumerate}

% =================================================
% TEMA 12
% =================================================

\newpage
\section{Tema 12. Técnicas de integración: integración de funciones trigonométricas e integración de funciones racionales}

\subsection{1.- Integra las siguientes funciones trigonométricas:}
\begin{enumerate}[label=\alph*)]
  \item $\displaystyle\int\cos^7x\,dx$. Se separa un factor $\cos x$ y se usa $u=\sin x$:
  \[
  \int(1-\sin^2x)^3\cos x\,dx
  =\boxed{\sin x-\sin^3x+\frac35\sin^5x-\frac17\sin^7x+C}.
  \]
  \item $\displaystyle\int(\sin^4x)(\cos^3x)dx$. Se reserva $\cos x$ y se usa $u=\sin x$:
  \[
  \int u^4(1-u^2)du
  =\boxed{\frac{\sin^5x}{5}-\frac{\sin^7x}{7}+C}.
  \]
  \item $\displaystyle\int\sin^5x\,dx$. Se reserva $\sin x$ y se usa $u=\cos x$:
  \[
  -\int(1-u^2)^2du
  =\boxed{-\cos x+\frac23\cos^3x-\frac15\cos^5x+C}.
  \]
  \item $\displaystyle\int(\sin^3x)(\cos^4x)dx$. Se reserva $\sin x$ y se usa $u=\cos x$:
  \[
  -\int(u^4-u^6)du
  =\boxed{-\frac15\cos^5x+\frac17\cos^7x+C}.
  \]
  \item $\displaystyle\int\cos^4x\,dx$. Con reducción de potencia, $\cos^4x=\frac{3+4\cos2x+\cos4x}{8}$:
  \[
  \boxed{\frac{3x}{8}+\frac{\sin2x}{4}+\frac{\sin4x}{32}+C}.
  \]
  \item $\displaystyle\int\sin^6x\,dx$. Con reducción de potencia, $\sin^6x=\frac{10-15\cos2x+6\cos4x-\cos6x}{32}$:
  \[
  \boxed{\frac{5x}{16}-\frac{15\sin2x}{64}+\frac{3\sin4x}{64}-\frac{\sin6x}{192}+C}.
  \]
  \item $\displaystyle\int(\sin^2x)(\cos^2x)dx$. Como $\sin^2x\cos^2x=\frac18(1-\cos4x)$:
  \[
  \boxed{\frac{x}{8}-\frac{\sin4x}{32}+C}.
  \]
  \item $\displaystyle\int(\tan^4x)(\sec^4x)dx$. Se escribe $\sec^4x=(1+\tan^2x)\sec^2x$ y se usa $u=\tan x$:
  \[
  \int u^4(1+u^2)du
  =\boxed{\frac{\tan^5x}{5}+\frac{\tan^7x}{7}+C}.
  \]
  \item $\displaystyle\int(\tan^3x)(\sec^5x)dx$. Se separa $\sec x\tan x\,dx$ y se usa $u=\sec x$:
  \[
  \int(u^2-1)u^4du
  =\boxed{\frac{\sec^7x}{7}-\frac{\sec^5x}{5}+C}.
  \]
  \item $\displaystyle\int(\sin3x)(\cos4x)dx$. Por producto a suma, $\sin3x\cos4x=\frac12(\sin7x-\sin x)$:
  \[
  \boxed{-\frac{\cos7x}{14}+\frac{\cos x}{2}+C}.
  \]
\end{enumerate}

\subsection{2.- Integra las siguientes funciones racionales:}
\begin{enumerate}[label=\alph*)]
  \item $\displaystyle\int\frac{x^4+3x^2+x}{x-2}dx$. División algebraica:
  \[
  \frac{x^4+3x^2+x}{x-2}=x^3+2x^2+7x+15+\frac{30}{x-2}.
  \]
  \[
  \boxed{\frac{x^4}{4}+\frac{2x^3}{3}+\frac{7x^2}{2}+15x+30\ln|x-2|+C}.
  \]
  \item $\displaystyle\int\frac{x+12}{x^2+5x+6}dx$. Factorizando y descomponiendo:
  \[
  \frac{x+12}{(x+2)(x+3)}=\frac{10}{x+2}-\frac9{x+3}.
  \]
  \[
  \boxed{10\ln|x+2|-9\ln|x+3|+C}.
  \]
  \item $\displaystyle\int\frac{2x+3}{x^3+x^2-6x}dx$. Factorizamos $x(x+3)(x-2)$:
  \[
  \frac{2x+3}{x(x+3)(x-2)}=-\frac1{2x}+\frac7{10(x-2)}-\frac1{5(x+3)}.
  \]
  \[
  \boxed{-\frac12\ln|x|+\frac7{10}\ln|x-2|-\frac15\ln|x+3|+C}.
  \]
  \item $\displaystyle\int\frac{x^2}{x^4-5x^2+4}dx$. Como $x^4-5x^2+4=(x^2-1)(x^2-4)$:
  \[
  \frac{x^2}{(x^2-1)(x^2-4)}=-\frac1{3(x+2)}+\frac1{6(x+1)}-\frac1{6(x-1)}+\frac1{3(x-2)}.
  \]
  \[
  \boxed{-\frac13\ln|x+2|+\frac16\ln|x+1|-\frac16\ln|x-1|+\frac13\ln|x-2|+C}.
  \]
  \item $\displaystyle\int\frac{x+1}{x^2-6x+9}dx=\int\left(\frac1{x-3}+\frac4{(x-3)^2}\right)dx$:
  \[
  \boxed{\ln|x-3|-\frac4{x-3}+C}.
  \]
  \item $\displaystyle\int\frac{x}{x^3-3x^2+3x-1}dx=\int\frac{x}{(x-1)^3}dx$.
  \[
  \frac{x}{(x-1)^3}=\frac1{(x-1)^2}+\frac1{(x-1)^3},\qquad
  \boxed{-\frac1{x-1}-\frac1{2(x-1)^2}+C}.
  \]
  \item $\displaystyle\int\frac{x+1}{x^3+2x}dx=\int\left[\frac1{2x}-\frac{x-2}{2(x^2+2)}\right]dx$:
  \[
  \boxed{\frac12\ln|x|-\frac14\ln(x^2+2)+\frac1{\sqrt2}\arctan\left(\frac{x}{\sqrt2}\right)+C}.
  \]
  \item $\displaystyle\int\frac{x+1}{x^4+3x^2+2}dx$. Como $x^4+3x^2+2=(x^2+1)(x^2+2)$:
  \[
  \frac{x+1}{(x^2+1)(x^2+2)}=\frac{x+1}{x^2+1}-\frac{x+1}{x^2+2}.
  \]
  \[
  \boxed{\frac12\ln(x^2+1)+\arctan x-\frac12\ln(x^2+2)-\frac1{\sqrt2}\arctan\left(\frac{x}{\sqrt2}\right)+C}.
  \]
  \item $\displaystyle\int\frac{x^3+1}{x^4+4x^2+4}dx=\int\frac{x^3+1}{(x^2+2)^2}dx$.
  \[
  \frac{x^3+1}{(x^2+2)^2}=\frac{x}{x^2+2}-\frac{2x-1}{(x^2+2)^2}.
  \]
  Integrando cada término:
  \[
  \boxed{\frac12\ln(x^2+2)+\frac{x+4}{4(x^2+2)}+\frac1{4\sqrt2}\arctan\left(\frac{x}{\sqrt2}\right)+C}.
  \]
  \item $\displaystyle\int\frac{3x+4}{(x+1)(x+2)^2}dx$. Fracciones parciales:
  \[
  \frac{3x+4}{(x+1)(x+2)^2}=\frac1{x+1}-\frac1{x+2}+\frac2{(x+2)^2}.
  \]
  \[
  \boxed{\ln|x+1|-\ln|x+2|-\frac2{x+2}+C}.
  \]
\end{enumerate}

