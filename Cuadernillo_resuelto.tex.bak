\section{Tema 10. Introducción a las integrales}

\subsection*{1.- Resuelve las siguientes integrales definidas. Para cada una, grafique la función correspondiente e ilumine el área a la que hace referencia la integral. Haga un cálculo aproximado del área descomponiéndola en figuras geométricas básica (por ejemplo, rectángulos, cuadrados, triángulos, etc.).}
\begin{enumerate}[label=\alph*)]
  \item $\displaystyle\int_0^4(x+2)\,dx$. La región es un trapecio de bases $2$ y $6$, y altura $4$; área $\frac{2+6}{2}(4)=16$.\\
  $\displaystyle\left[\frac{x^2}{2}+2x\right]_0^4=\boxed{16}$.\grafica
  \item $\displaystyle\int_0^2(-x+4)\,dx$. La región es un trapecio de bases $4$ y $2$, y altura $2$; área $\frac{4+2}{2}(2)=6$.\\
  $\displaystyle\left[-\frac{x^2}{2}+4x\right]_0^2=\boxed{6}$.\grafica
  \item $\displaystyle\int_0^6 5\,dx$. La región es un rectángulo de base $6$ y altura $5$; área $6(5)=30$.\\
  $\displaystyle[5x]_0^6=\boxed{30}$.\grafica
  \item $\displaystyle\int_{-3}^3(-x+1)\,dx$. La integral con signo es
  $\displaystyle\left[-\frac{x^2}{2}+x\right]_{-3}^3=\boxed{6}$. Para distinguir el área geométrica total: de $-3$ a $1$ hay un trapecio de área $8$ y de $1$ a $3$ un triángulo debajo del eje $x$ de área $2$; el área geométrica total es $8+2=10$, mientras que el área con signo es $8-2=6$.\grafica
  \item $\displaystyle\int_0^{2\pi}\sin x\,dx$.\\
  $\displaystyle[-\cos x]_0^{2\pi}=(-1)-(-1)=\boxed{0}$. El área geométrica sin signo es $2+2=4$: dos regiones iguales, una sobre el eje $x$ y otra debajo.\grafica
\end{enumerate}

\subsection*{2.- Resuelve las siguientes integrales inmediatas:}
\begin{enumerate}[label=\alph*)]
  \item $\displaystyle\int(3x^2+\cos x)\,dx=\boxed{x^3+\sin x+C}$.
  \item $\displaystyle\int(e^x-\sin x)\,dx=\boxed{e^x+\cos x+C}$.
  \item $\displaystyle\int(4\cos x+5\sin x)\,dx=\boxed{4\sin x-5\cos x+C}$.
  \item $\displaystyle\int\left(x^3+\frac12x^2+\frac{2}{\sqrt3}x+4\right)dx$
  \[
  =\boxed{\frac{x^4}{4}+\frac{x^3}{6}+\frac{x^2}{\sqrt3}+4x+C}.
  \]
  \item $\displaystyle\int\left(3\sqrt{x}-5\sqrt[5]{x}\right)dx$
  \[
  =\int(3x^{1/2}-5x^{1/5})dx
  =\boxed{2x^{3/2}-\frac{25}{6}x^{6/5}+C}.
  \]
  \item $\displaystyle\int\left(\frac3{x^5}+\frac4{x^2}+\frac5x\right)dx$
  \[
  =\boxed{-\frac{3}{4x^4}-\frac4x+5\ln|x|+C}.
  \]
  \item $\displaystyle\int\frac5{\sqrt[3]{x^2}}dx=5\int x^{-2/3}dx=\boxed{15\sqrt[3]{x}+C}$.
  \item $\displaystyle\int(2\tan x-3\sin x)dx=\boxed{-2\ln|\cos x|+3\cos x+C}$.
  \item $\displaystyle\int\left(\frac3{1+x^2}+\frac4{\sqrt{1-x^2}}\right)dx$
  \[
  =\boxed{3\arctan x+4\arcsin x+C}.
  \]
  \item $\displaystyle\int\left(\frac5{x^2-4}+\frac4{x\sqrt{x^2-9}}\right)dx$
  \[
  =\frac54\int\left(\frac1{x-2}-\frac1{x+2}\right)dx
  +4\int\frac{dx}{x\sqrt{x^2-9}}
  \]
  \[
  =\boxed{\frac54\ln\left|\frac{x-2}{x+2}\right|+\frac43\arcsec\left(\frac{|x|}{3}\right)+C}.
  \]
\end{enumerate}

