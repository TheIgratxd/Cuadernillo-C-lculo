\newpage
\section{Tema 5. Continuidad}

\subsection*{1.- En cada uno de los siguientes ejercicios, determina si la función es continua en $x=a$. Justifica claramente tu respuesta a partir de la definición de continuidad.}
Para que $f$ sea continua en $x=a$ deben cumplirse simultáneamente: (1) $f(a)$ está definida; (2) existe $\lim_{x\to a}f(x)$; y (3) el límite es igual a $f(a)$.
\begin{enumerate}[label=\alph*)]
  \item $f(x)=\dfrac{1}{x-3},\ a=3$. $f(3)$ no está definida y el límite bilateral no existe (los laterales divergen con signos opuestos). \textbf{No es continua} en $x=3$.
  \item $f(x)=\dfrac{x^2-9}{x-3},\ a=3$. Para $x\neq3$, $f(x)=x+3$, por lo que $\lim_{x\to3}f(x)=6$. Sin embargo, $f(3)$ no está definida. \textbf{No es continua} en $x=3$.
  \item $f(x)=\begin{cases}\dfrac{1}{x-3},&x\neq3,\\2,&x=3.\end{cases},\ a=3$. $f(3)=2$, pero $\lim_{x\to3^-}f(x)=-\infty$ y $\lim_{x\to3^+}f(x)=+\infty$. El límite bilateral no existe. \textbf{No es continua}.
  \item $f(x)=\begin{cases}\dfrac{x^2-9}{x-3},&x\neq3,\\2,&x=3.\end{cases},\ a=3$. Para $x\neq3$, $f(x)=x+3$, así que $\lim_{x\to3}f(x)=6$, mientras que $f(3)=2$. Como $6\neq2$, \textbf{no es continua}.
  \item $f(x)=\begin{cases}\dfrac{x^2-9}{x-3},&x\neq3,\\6,&x=3.\end{cases},\ a=3$. Para $x\neq3$, $f(x)=x+3$; por tanto, $\lim_{x\to3}f(x)=6=f(3)$. Se cumplen las tres condiciones: \textbf{sí es continua} en $x=3$.
\end{enumerate}

\subsection*{2.- Grafica la siguiente función seccionada. Identifica todos los valores de $x$ en los que la función no es continua. Para cada uno de dichos valores, determina: a) si la función es continua por la izquierda, b) si la función es continua por la derecha. Establezca todos los intervalos sobre los que la función es continua.}
\[
f(x)=\begin{cases}
-x,&x\leq-4,\\
x,&-4<x\leq-2,\\
x^2,&-2<x<2,\\
-2,&x=2,\\
x-3,&x>2.
\end{cases}
\]
\grafica
Los posibles puntos de discontinuidad son los cambios de regla: $x=-4,-2,2$.
\begin{itemize}
  \item En $x=-4$: $f(-4)=4$ y $\lim_{x\to-4^-}f(x)=4$, pero $\lim_{x\to-4^+}f(x)=-4$. Es \textbf{continua por la izquierda}, no por la derecha.
  \item En $x=-2$: $f(-2)=-2$ y $\lim_{x\to-2^-}f(x)=-2$, mientras que $\lim_{x\to-2^+}f(x)=4$. Es \textbf{continua por la izquierda}, no por la derecha.
  \item En $x=2$: $f(2)=-2$, $\lim_{x\to2^-}f(x)=4$ y $\lim_{x\to2^+}f(x)=-1$. No es continua ni por la izquierda ni por la derecha.
\end{itemize}
Los intervalos máximos en los que es continua son:
\[
\boxed{(-\infty,-4],\quad(-4,-2],\quad(-2,2),\quad(2,+\infty).}
\]

\subsection*{3.- Sea la función seccionada:}
\[
f(x)=\begin{cases}
x^2,&0\leq x\leq2,\\
x,&2<x<4,\\
4,&4<x\leq6.
\end{cases}
\]
Para cada una de las siguientes afirmaciones responde Falso (F) o Verdadero (V). En caso de ser falso explica por qué.
\begin{enumerate}[label=\alph*)]
  \item $f(2)=4$. \textbf{V}.
  \item $\lim_{x\to2^-}f(x)=4$. \textbf{V}, porque por la izquierda se usa $x^2$.
  \item $\lim_{x\to2^+}f(x)=2$. \textbf{V}, porque por la derecha se usa $x$.
  \item $\lim_{x\to2}f(x)$ no está definido. \textbf{V}, los límites laterales son distintos ($4\neq2$).
  \item $f(x)$ es continua por la izquierda en $x=2$. \textbf{V}, $\lim_{x\to2^-}f(x)=f(2)=4$.
  \item $f(x)$ es continua por la derecha en $x=2$. \textbf{F}, pues $\lim_{x\to2^+}f(x)=2\neq f(2)=4$.
  \item $f(x)$ es continua en $x=2$. \textbf{F}, el límite bilateral no existe.
  \item $f(x)$ es continua en el intervalo $[0,2]$. \textbf{V}, en ese intervalo coincide con $x^2$.
  \item $f(4)$ no está definida. \textbf{V}, ninguno de los tramos incluye $x=4$.
  \item $\lim_{x\to4^-}f(x)=2$. \textbf{F}, el límite por la izquierda es $4$.
  \item $\lim_{x\to4^+}f(x)=4$. \textbf{V}, a la derecha la función vale constantemente $4$.
  \item $\lim_{x\to4}f(x)=4$. \textbf{V}, ambos límites laterales valen $4$, aunque $f(4)$ no esté definida.
  \item $f(x)$ es continua por la izquierda en $x=4$. \textbf{F}, porque $f(4)$ no existe.
  \item $f(x)$ es continua por la derecha en $x=4$. \textbf{F}, porque $f(4)$ no existe.
  \item $f(x)$ es continua en $x=4$. \textbf{F}, no está definida en ese punto.
  \item $f(x)$ es continua en el intervalo $[2,4]$. \textbf{F}, $f(4)$ no está definida y además hay una discontinuidad en $x=2$.
  \item $f(x)$ es continua en el intervalo $(2,4)$. \textbf{V}, en ese intervalo $f(x)=x$.
\end{enumerate}

