\section{Tema 6. Límites cuando $x$ tiende a infinito}

\subsection*{1.- Para las siguientes funciones, realiza una conjetura del valor de $\lim_{x\to\infty}f(x)$ y de $\lim_{x\to-\infty}f(x)$ mediante un tabulado.}
\begin{enumerate}[label=\alph*)]
  \item $f(x)=\dfrac{2x+1}{x-2}$. Dividiendo entre $x$: $f(x)=\dfrac{2+1/x}{1-2/x}$. En ambos extremos se aproxima a $2$.\\
  \respuesta{\lim_{x\to+\infty}f(x)=2,\qquad\lim_{x\to-\infty}f(x)=2}
  \item $f(x)=\sqrt{x^2}=|x|$.\\
  \respuesta{\lim_{x\to+\infty}f(x)=+\infty,\qquad\lim_{x\to-\infty}f(x)=+\infty}
  \item $f(x)=-\dfrac{x^3}{4}$.\\
  \respuesta{\lim_{x\to+\infty}f(x)=-\infty,\qquad\lim_{x\to-\infty}f(x)=+\infty}
\end{enumerate}
\textbf{Tabulado para observar el comportamiento en ambos extremos:}
\begin{center}
\begin{tabular}{r|r|r|r}
$x$ & $f_a(x)=\frac{2x+1}{x-2}$ & $f_b(x)=\sqrt{x^2}$ & $f_c(x)=-\frac{x^3}{4}$\\\hline
$-100$ & $1.9510$ & $100$ & $250000$\\
$-10$ & $1.5833$ & $10$ & $2500$\\
$10$ & $2.6250$ & $10$ & $-2500$\\
$100$ & $2.0510$ & $100$ & $-250000$
\end{tabular}
\end{center}

\subsection*{2.- Evaluar los siguientes límites mediante manipulaciones algebraicas. Agrega la gráfica de la función y traza la asíntota horizontal correspondiente (si existe) para verificar tu respuesta.}
\begin{enumerate}[label=\alph*)]
  \item $\displaystyle\lim_{x\to\infty}\frac{x^3+2x}{x^2-1}=+\infty$. El grado del numerador es mayor; la función crece como $x$ positivo. No hay asíntota horizontal.\grafica
  \item $\displaystyle\lim_{x\to-\infty}\frac{x^3+2x}{x^2-1}=-\infty$. La función se comporta como $x$ para valores negativos grandes. No hay asíntota horizontal.\grafica
  \item $\displaystyle\lim_{x\to\infty}\frac{x^2+1}{2x^3-1}=0$. El denominador tiene mayor grado. Asíntota horizontal: $y=0$.\grafica
  \item $\displaystyle\lim_{x\to\infty}\frac{x^2+1}{2x^2-1}=\boxed{\frac12}$. Se divide entre $x^2$. Asíntota horizontal: $y=\frac12$.\grafica
  \item $\displaystyle\lim_{x\to\infty}\frac{x^5+2x^3+1}{x^2-1}=+\infty$. El cociente se comporta como $x^3$. No hay asíntota horizontal.\grafica
  \item $\displaystyle\lim_{x\to-\infty}\frac{x^5+2x^3+1}{x^2-1}=-\infty$. El cociente se comporta como $x^3$. No hay asíntota horizontal.\grafica
  \item $\displaystyle\lim_{x\to\infty}\frac{\sqrt{x^2+1}}{2x^2-1}=0$. El numerador crece como $x$ y el denominador como $2x^2$. Asíntota horizontal: $y=0$.\grafica
  \item $\displaystyle\lim_{x\to\infty}\frac{\sqrt{x^7+1}}{2x^3-1}=+\infty$. Para $x>0$, el cociente se comporta como $\frac12\sqrt{x}$. No hay asíntota horizontal.\grafica
  \item $\displaystyle\lim_{x\to-\infty}\frac{\sqrt{x^7+1}}{2x^3-1}$. \textbf{El límite no está definido en los reales}: $x^7+1<0$ para todo $x<-1$, de modo que la función no tiene valores reales arbitrariamente lejos hacia $-\infty$. Se conserva aquí la expresión tal como aparece impresa en el cuadernillo.\grafica
  \item $\displaystyle\lim_{x\to\infty}\frac{\sqrt{9x^6-x}}{x^3+1}=3$. Para $x>0$, se divide numerador y denominador entre $x^3$: el cociente tiende a $3$. Asíntota horizontal: $y=3$.\grafica
  \item $\displaystyle\lim_{x\to-\infty}\frac{\sqrt{9x^6-x}}{x^3+1}=-3$. Como $\sqrt{x^6}=|x^3|=-x^3$ cuando $x<0$, el cociente tiende a $-3$. Asíntota horizontal: $y=-3$.\grafica
  \item $\displaystyle\lim_{x\to\infty}\frac{\sqrt{9x^6-x}-x^3}{5x^3+1}=\frac{3-1}{5}=\boxed{\frac25}$. Asíntota horizontal: $y=\frac25$.\grafica
  \item $\displaystyle\lim_{x\to-\infty}\frac{\sqrt{9x^6-x}-x^3}{5x^3+1}=\frac{-3-1}{5}=\boxed{-\frac45}$. Asíntota horizontal: $y=-\frac45$.\grafica
\end{enumerate}

