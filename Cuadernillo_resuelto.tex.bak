\section{Tema 2. Funciones algebraicas y funciones trascendentes}

Utiliza un graficador para mostrar las gráficas de las siguientes funciones. Puedes colocar varias funciones en un mismo plano cartesiano siempre y cuando se distingan claramente una de la otra (por ejemplo, ponerlas con diferentes colores).

\subsection*{FUNCIONES ALGEBRAICAS}
\subsubsection*{1.- Funciones constantes}
\begin{enumerate}[label=\alph*)]
  \item $y=4$ \item $y=2$ \item $y=-2$ \item $y=-5$ \item $y=0$
\end{enumerate}
\grafica

\subsubsection*{2.- Funciones polinómicas de primer grado}
\begin{enumerate}[label=\alph*)]
  \item $y=x$ \item $y=2x$ \item $y=5x$ \item $y=\dfrac12x$ \item $y=\dfrac15x$
\end{enumerate}
\grafica
\begin{enumerate}[label=\alph*), start=6]
  \item $y=-x$ \item $y=-2x$ \item $y=-\dfrac13x$ \item $y=x+5$ \item $y=x-3$
\end{enumerate}
\grafica
\begin{enumerate}[label=\alph*), start=11]
  \item $y=2x+3$ \item $y=2x-3$ \item $y=-2x+3$ \item $y=-2x-3$
\end{enumerate}
\grafica

\subsubsection*{3.- Funciones polinómicas de segundo grado}
\begin{enumerate}[label=\alph*)]
  \item $y=x^2$ \item $y=2x^2$ \item $y=5x^2$ \item $y=\dfrac12x^2$ \item $y=-x^2$
\end{enumerate}
\grafica
\begin{enumerate}[label=\alph*), start=6]
  \item $y=-2x^2$ \item $y=-\dfrac12x^2$ \item $y=x^2+3$ \item $y=x^2-3$ \item $y=2x^2+1$
\end{enumerate}
\grafica
\begin{enumerate}[label=\alph*), start=11]
  \item $y=-x^2+2$ \item $y=-x^2-2$ \item $y=(x+2)^2$ \item $y=(x-3)^2$ \item $y=(x+2)^2+3$ \item $y=(x+2)^2-3$
\end{enumerate}
\grafica

\subsubsection*{4.- Funciones polinómicas de grado superior a dos}
\begin{enumerate}[label=\alph*)]
  \item $y=x^3$ \item $y=2x^3$ \item $y=-x^3$ \item $y=x^3+2$ \item $y=x^3-2$
\end{enumerate}
\grafica
\begin{enumerate}[label=\alph*), start=6]
  \item $y=(x+2)^3$ \item $y=(x-2)^3$ \item $y=x^4$ \item $y=x^5$ \item $y=x^6$
\end{enumerate}
\grafica

\subsubsection*{5.- Funciones racionales}
\begin{enumerate}[label=\alph*)]
  \item $y=\dfrac1x$ \item $y=\dfrac3x$ \item $y=\dfrac7x$ \item $y=-\dfrac1x$ \item $y=-\dfrac3x$
\end{enumerate}
\grafica
\begin{enumerate}[label=\alph*), start=6]
  \item $y=\dfrac7x+3$ \item $y=\dfrac7x-2$ \item $y=\dfrac7{x-2}$ \item $y=\dfrac7{x+3}$ \item $y=\dfrac7{x+2}-3$ \item $y=\dfrac7{x+2}+3$
\end{enumerate}
\grafica

\subsubsection*{6.- Funciones radicales}
\begin{enumerate}[label=\alph*)]
  \item $y=\sqrt{x}$ \item $y=-\sqrt{x}$ \item $y=\sqrt{x+2}$ \item $y=\sqrt{x-3}$ \item $y=\sqrt{x}+3$
\end{enumerate}
\grafica
\begin{enumerate}[label=\alph*), start=6]
  \item $y=\sqrt{x}-3$ \item $y=\sqrt{x-3}+2$ \item $y=\sqrt[3]{x}$ \item $y=\sqrt[4]{x}$
\end{enumerate}
\grafica

\subsection*{FUNCIONES TRASCENDENTES}
\subsubsection*{7.- Funciones exponenciales}
\begin{enumerate}[label=\alph*)]
  \item $y=2^x$ \item $y=2^{-x}$ \item $y=\left(\dfrac12\right)^x$ \item $y=3^x$ \item $y=2^x+3$
\end{enumerate}
\grafica
