\section{Tema 1. Funciones}

\subsection*{1.- Encuentra el dominio y rango de las siguientes funciones. Muestra la gráfica de la función.}
\begin{enumerate}[label=\alph*)]
  \item $y=2x-3$.\grafica
  \textbf{Dominio: }$\R$. \quad \textbf{Rango: }$\R$.
  \item $y=x^2+1$.\grafica
  \textbf{Dominio: }$\R$. \quad \textbf{Rango: }$[1,+\infty)$, pues $x^2\geq0$.
  \item $y=\sqrt{x-2}$.\grafica
  Para que la raíz sea real, $x-2\geq0$.\\
  \textbf{Dominio: }$[2,+\infty)$. \quad \textbf{Rango: }$[0,+\infty)$.
  \item $y=\dfrac{1}{x+3}$.\grafica
  El denominador no puede ser cero: $x\neq-3$. Además, la fracción nunca vale cero.\\
  \textbf{Dominio: }$\R\setminus\{-3\}$. \quad \textbf{Rango: }$\R\setminus\{0\}$.
  \item $y=x^3+2$.\grafica
  \textbf{Dominio: }$\R$. \quad \textbf{Rango: }$\R$.
\end{enumerate}

\subsection*{2.- Encuentra el dominio de las siguientes funciones. Muestra la gráfica de la función.}
\begin{enumerate}[label=\alph*)]
  \item $y=\dfrac{1}{x^2-9}$.\grafica
  $x^2-9=(x-3)(x+3)\neq0$. \respuesta{D=(-\infty,-3)\cup(-3,3)\cup(3,+\infty)}
  \item $y=\dfrac{1}{x^2-5x+6}$.\grafica
  $x^2-5x+6=(x-2)(x-3)\neq0$. \respuesta{D=\R\setminus\{2,3\}}
  \item $y=\dfrac{1}{x^2+6x+9}$.\grafica
  $x^2+6x+9=(x+3)^2\neq0$. \respuesta{D=\R\setminus\{-3\}}
  \item $y=\dfrac{1}{x^2-x-6}$.\grafica
  $x^2-x-6=(x-3)(x+2)\neq0$. \respuesta{D=\R\setminus\{-2,3\}}
  \item $y=\dfrac{\sqrt{x}}{x^2-x-6}$.\grafica
  Se requiere $x\geq0$ y $(x-3)(x+2)\neq0$. Al intersectar las condiciones: 
  \respuesta{D=[0,3)\cup(3,+\infty)}
\end{enumerate}

\subsection*{3.- Muestre la gráfica de las siguientes funciones seccionadas}
\begin{enumerate}[label=\alph*)]
  \item $f(x)=\begin{cases}x^2,&\text{si }x<2,\\x+6,&\text{si }x\geq2.\end{cases}$\grafica
  \item $f(x)=\begin{cases}x^2,&\text{si }x\leq2,\\x+6,&\text{si }x>2.\end{cases}$\grafica
  \item $f(x)=\begin{cases}x^2,&\text{si }x<2,\\x+6,&\text{si }x>2.\end{cases}$\grafica
  \item $f(x)=\begin{cases}x^2,&\text{si }x<2,\\6,&\text{si }x=2,\\x+6,&\text{si }x>2.\end{cases}$\grafica
  \item $f(x)=\begin{cases}-1,&\text{si }x\leq0,\\1,&\text{si }0<x<3,\\2,&\text{si }x\geq3.\end{cases}$\grafica
\end{enumerate}

\subsection*{4.- Para las siguientes funciones, indica si se trata de una función par, una función impar, o ninguna de las anteriores.}
\begin{enumerate}[label=\alph*)]
  \item $f(x)=x^4$. Como $f(-x)=(-x)^4=x^4=f(x)$, \textbf{es par}.
  \item $f(x)=\dfrac1x$. Como $f(-x)=\dfrac1{-x}=-\dfrac1x=-f(x)$, \textbf{es impar}.
  \item $f(x)=x+1$. $f(-x)=-x+1$, que no es igual a $f(x)$ ni a $-f(x)$. \textbf{No es par ni impar}.
  \item $f(x)=x$. $f(-x)=-x=-f(x)$, \textbf{es impar}.
  \item $f(x)=\dfrac1{x^2}$. $f(-x)=\dfrac1{(-x)^2}=\dfrac1{x^2}=f(x)$, \textbf{es par}.
\end{enumerate}

\subsection*{5.- Para las siguientes funciones, indica los intervalos en que son crecientes y los intervalos en que son decrecientes.}
\begin{enumerate}[label=\alph*)]
  \item $f(x)=-3x+2$. Pendiente negativa: \textbf{decreciente en }$(-\infty,+\infty)$.
  \item $f(x)=x^3$. \textbf{Creciente en }$(-\infty,+\infty)$.
  \item $f(x)=x^2+4$. \textbf{Decreciente en }$(-\infty,0]$ y \textbf{creciente en }$[0,+\infty)$.
  \item $f(x)=-|x|=\begin{cases}x,&x<0,\\-x,&x\geq0.\end{cases}$ \textbf{Creciente en }$(-\infty,0]$ y \textbf{decreciente en }$[0,+\infty)$.
  \item $f(x)=5$. Es constante en $\R$; no es estrictamente creciente ni estrictamente decreciente (es no decreciente y no creciente a la vez).
\end{enumerate}

