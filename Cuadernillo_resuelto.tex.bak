  \item $y=2^{x+3}$ \item $y=2^{x-3}-4$ \item $y=e^x$ \item $y=e^{-x}$
\end{enumerate}
\grafica

\subsubsection*{8.- Funciones logarítmicas}
\begin{enumerate}[label=\alph*)]
  \item $y=\log_2x$ \item $y=\log x$ \item $y=\ln x$ \item $y=-\log_2x$ \item $y=\log_{1/2}x$
\end{enumerate}
\grafica
\begin{enumerate}[label=\alph*), start=6]
  \item $y=(\log_2x)+3$ \item $y=\log_2(x+3)$
\end{enumerate}
\grafica

\subsubsection*{9.- Funciones trigonométricas}
\begin{enumerate}[label=\alph*)]
  \item $y=\sin x$ \item $y=\cos x$ \item $y=\tan x$ \item $y=\csc x$ \item $y=\sec x$
\end{enumerate}
\grafica
\begin{enumerate}[label=\alph*), start=6]
  \item $y=\cot x$ \item $y=2\sin x$ \item $y=(\sin x)+2$ \item $y=\sin(x+30^\circ)$
\end{enumerate}
\grafica

\subsubsection*{10.- Funciones trigonométricas inversas}
\begin{enumerate}[label=\alph*)]
  \item $y=\sin^{-1}x$ \item $y=\cos^{-1}x$ \item $y=\tan^{-1}x$ \item $y=\csc^{-1}x$ \item $y=\sec^{-1}x$ \item $y=\cot^{-1}x$
\end{enumerate}
\grafica

