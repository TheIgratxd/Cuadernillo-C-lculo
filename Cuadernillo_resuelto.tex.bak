\newpage
\section{Tema 7. Definición de derivada}

Encuentre la derivada de las siguientes funciones utilizando la definición de derivada como límite:
\[
f'(x)=\lim_{h\to0}\frac{f(x+h)-f(x)}{h}.
\]
\begin{enumerate}[label=\alph*)]
  \item $f(x)=x$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{(x+h)-x}{h}=\lim_{h\to0}\frac{h}{h}=\boxed{1}$.
  \item $f(x)=x^2$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{(x+h)^2-x^2}{h}=\lim_{h\to0}(2x+h)=\boxed{2x}$.
  \item $f(x)=x^3$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{3x^2h+3xh^2+h^3}{h}=\lim_{h\to0}(3x^2+3xh+h^2)=\boxed{3x^2}$.
  \item $f(x)=x^4$:
  $\displaystyle f'(x)=\lim_{h\to0}\left(4x^3+6x^2h+4xh^2+h^3\right)=\boxed{4x^3}$.
  \item $f(x)=x^5$:
  $\displaystyle f'(x)=\lim_{h\to0}\left(5x^4+10x^3h+10x^2h^2+5xh^3+h^4\right)=\boxed{5x^4}$.
  \item $f(x)=3$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{3-3}{h}=\boxed{0}$.
  \item $f(x)=3x^2$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{3[(x+h)^2-x^2]}{h}=\boxed{6x}$.
  \item $f(x)=2x^2+4x+1$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{2(2xh+h^2)+4h}{h}=\boxed{4x+4}$.
  \item $f(x)=\dfrac1x$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{\frac1{x+h}-\frac1x}{h}=\lim_{h\to0}\frac{-1}{x(x+h)}=\boxed{-\frac1{x^2}}$.
  \item $f(x)=\dfrac1{x^2}$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{x^2-(x+h)^2}{h x^2(x+h)^2}=\lim_{h\to0}\frac{-(2x+h)}{x^2(x+h)^2}=\boxed{-\frac2{x^3}}$.
  \item $f(x)=\dfrac1{x^3}$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{x^3-(x+h)^3}{h x^3(x+h)^3}=\boxed{-\frac3{x^4}}$.
  \item $f(x)=\sqrt{x}$:
  $\displaystyle f'(x)=\lim_{h\to0}\frac{\sqrt{x+h}-\sqrt{x}}{h}=\lim_{h\to0}\frac{1}{\sqrt{x+h}+\sqrt{x}}=\boxed{\frac{1}{2\sqrt{x}}}$, para $x>0$.
  \item $f(x)=\dfrac1{\sqrt{x}}$:
  \[
  f'(x)=\lim_{h\to0}\frac{\frac1{\sqrt{x+h}}-\frac1{\sqrt{x}}}{h}
  =\lim_{h\to0}\frac{-1}{\sqrt{x}\sqrt{x+h}(\sqrt{x}+\sqrt{x+h})}
  =\boxed{-\frac{1}{2x^{3/2}}},\quad x>0.
  \]
\end{enumerate}

