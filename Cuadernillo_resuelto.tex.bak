\section{Tema 4. Límites}

\subsection*{1. Grafica la función $f(x)=\dfrac{x^2-1}{x-1}$ e indica cuánto vale $f(1)$. Realiza una conjetura del valor de $\displaystyle\lim_{x\to1}\dfrac{x^2-1}{x-1}$ mediante un tabulado con valores de $x$ cercanos a 1.}
\[
f(x)=\frac{x^2-1}{x-1}=\frac{(x-1)(x+1)}{x-1}=x+1,\qquad x\neq1.
\]
En $x=1$ la expresión original produce $0/0$, por lo que $f(1)$ no está definida. La gráfica es la recta $y=x+1$ con un hueco en $(1,2)$.\grafica
\begin{center}
\begin{tabular}{c|c@{\qquad}c|c}
$x$ (izquierda) & $f(x)$ & $x$ (derecha) & $f(x)$\\\hline
0.9 & 1.9 & 1.1 & 2.1\\
0.99 & 1.99 & 1.01 & 2.01\\
0.999 & 1.999 & 1.001 & 2.001\\
0.9999 & 1.9999 & 1.0001 & 2.0001
\end{tabular}
\end{center}
\respuesta{f(1)\text{ no existe},\qquad \lim_{x\to1}f(x)=2}

\subsection*{2. Obtenga la gráfica de la función y a partir de ella indica cuánto vale $f(1)$ y $\displaystyle\lim_{x\to1}f(x)$ para cada uno de los siguientes incisos.}
\begin{enumerate}[label=\alph*)]
  \item $f(x)=\begin{cases}x^2,&x\leq1,\\-x+2,&x>1.\end{cases}$\grafica
  $f(1)=1$. Además, $\lim_{x\to1^-}f(x)=1$ y $\lim_{x\to1^+}f(x)=1$. Por tanto, $\boxed{\lim_{x\to1}f(x)=1}$.
  \item $f(x)=\begin{cases}x^2,&x<1,\\-x+2,&x>1.\end{cases}$\grafica
  $f(1)$ no está definida. Los límites laterales valen $1$ y $1$, así que $\boxed{\lim_{x\to1}f(x)=1}$.
  \item $f(x)=\begin{cases}x^2,&x<1,\\3,&x=1,\\-x+2,&x>1.\end{cases}$\grafica
  $f(1)=3$. Los dos límites laterales valen $1$, por lo que $\boxed{\lim_{x\to1}f(x)=1}$.
  \item $f(x)=\begin{cases}x^2,&x\leq1,\\-x+3,&x>1.\end{cases}$\grafica
  $f(1)=1$. El límite izquierdo vale $1$ y el derecho vale $2$; por tanto, $\boxed{\lim_{x\to1}f(x)\text{ no existe}}$.
  \item $f(x)=\begin{cases}x^2,&x<1,\\-x+3,&x>1.\end{cases}$\grafica
  $f(1)$ no está definida. Los límites laterales son $1$ y $2$, respectivamente; por tanto, $\boxed{\lim_{x\to1}f(x)\text{ no existe}}$.
\end{enumerate}

\subsection*{3. Obtenga la gráfica de la función y a partir de ella indica cuánto vale $f(1)$, $\lim_{x\to1^-}f(x)$, $\lim_{x\to1^+}f(x)$ y $\lim_{x\to1}f(x)$ para cada uno de los siguientes incisos.}
\begin{enumerate}[label=\alph*)]
  \item $f(x)=\begin{cases}x^2,&x\leq1,\\-(x-1)^2+1,&x>1.\end{cases}$\grafica
  $f(1)=1$, $\lim_{x\to1^-}f(x)=1$, $\lim_{x\to1^+}f(x)=1$ y $\boxed{\lim_{x\to1}f(x)=1}$.
  \item $f(x)=\begin{cases}x^2+1,&x\leq1,\\-(x-1)^2+1,&x>1.\end{cases}$\grafica
  $f(1)=2$, $\lim_{x\to1^-}f(x)=2$, $\lim_{x\to1^+}f(x)=1$. Como los laterales son distintos, $\boxed{\lim_{x\to1}f(x)\text{ no existe}}$.
\end{enumerate}

\subsection*{4. Grafica la función $f(x)=\dfrac{1}{|x-1|}$ e indica cuánto vale $f(1)$. Realiza una conjetura del valor de $\displaystyle\lim_{x\to1}\dfrac{1}{|x-1|}$ mediante un tabulado con valores de $x$ cercanos a 1.}
\grafica
$f(1)$ no está definida porque el denominador vale cero. Al acercarse a 1 por ambos lados, $|x-1|$ se aproxima a cero por valores positivos.
\begin{center}
\begin{tabular}{c|c@{\qquad}c|c}
$x$ (izquierda) & $f(x)$ & $x$ (derecha) & $f(x)$\\\hline
0.9 & 10 & 1.1 & 10\\
0.99 & 100 & 1.01 & 100\\
0.999 & 1000 & 1.001 & 1000
\end{tabular}
\end{center}
\respuesta{\lim_{x\to1^-}f(x)=+\infty,\quad \lim_{x\to1^+}f(x)=+\infty,\quad \lim_{x\to1}f(x)=+\infty}

\subsection*{5. Obtenga la gráfica de la función y a partir de ella indica cuánto vale $f(1)$, $\lim_{x\to1^-}f(x)$, $\lim_{x\to1^+}f(x)$ y $\lim_{x\to1}f(x)$ para cada uno de los siguientes incisos.}
\begin{enumerate}[label=\alph*)]
  \item $f(x)=\left(\dfrac{1}{x-1}\right)^2$.\grafica
  $f(1)$ no existe; ambos límites laterales son $+\infty$. \respuesta{\lim_{x\to1}f(x)=+\infty}
  \item $f(x)=-\left|\dfrac{1}{x-1}\right|$.\grafica
  $f(1)$ no existe; ambos límites laterales son $-\infty$. \respuesta{\lim_{x\to1}f(x)=-\infty}
  \item $f(x)=\dfrac{1}{x-1}$.\grafica
  $f(1)$ no existe, $\lim_{x\to1^-}f(x)=-\infty$ y $\lim_{x\to1^+}f(x)=+\infty$. \respuesta{\lim_{x\to1}f(x)\text{ no existe}}
  \item $f(x)=-\dfrac{1}{x-1}$.\grafica
  $f(1)$ no existe, $\lim_{x\to1^-}f(x)=+\infty$ y $\lim_{x\to1^+}f(x)=-\infty$. \respuesta{\lim_{x\to1}f(x)\text{ no existe}}
\end{enumerate}

\subsection*{6. Evalúe los siguientes límites eliminando las indeterminaciones por métodos algebraicos.}
\begin{enumerate}[label=\alph*)]
  \item $\displaystyle\lim_{x\to0}\frac{x^2}{x}=\lim_{x\to0}x=\boxed{0}$.
  \item $\displaystyle\lim_{x\to5}\frac{x^2-6x+5}{x-5}=\lim_{x\to5}\frac{(x-1)(x-5)}{x-5}=\boxed{4}$.
  \item $\displaystyle\lim_{x\to4}\frac{x^2-4x}{x^2-3x-4}=\lim_{x\to4}\frac{x(x-4)}{(x-4)(x+1)}=\boxed{\frac45}$.
  \item $\displaystyle\lim_{x\to-3}\frac{x^2-9}{2x^2+7x+3}=\lim_{x\to-3}\frac{(x-3)(x+3)}{(2x+1)(x+3)}=\boxed{\frac65}$.
  \item $\displaystyle\lim_{x\to-2}\frac{x+2}{x^3+8}=\lim_{x\to-2}\frac{1}{x^2-2x+4}=\boxed{\frac1{12}}$.
  \item $\displaystyle\lim_{x\to1}\frac{x^4-1}{x^3-1}=\lim_{x\to1}\frac{(x+1)(x^2+1)}{x^2+x+1}=\boxed{\frac43}$.
  \item $\displaystyle\lim_{x\to-1}\frac{x^2+2x+1}{x^4-1}=\lim_{x\to-1}\frac{x+1}{(x-1)(x^2+1)}=\boxed{0}$.
  \item $\displaystyle\lim_{x\to0}\frac{\sqrt{9+x}-3}{x}=\lim_{x\to0}\frac{1}{\sqrt{9+x}+3}=\boxed{\frac16}$.
  \item $\displaystyle\lim_{x\to3}\frac{\sqrt{x+1}-2}{x-3}=\lim_{x\to3}\frac{1}{\sqrt{x+1}+2}=\boxed{\frac14}$.
  \item $\displaystyle\lim_{x\to-4}\frac{\sqrt{x^2+9}-5}{x+4}=\lim_{x\to-4}\frac{x-4}{\sqrt{x^2+9}+5}=\boxed{-\frac45}$.
\end{enumerate}

